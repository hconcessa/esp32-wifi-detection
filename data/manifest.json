{
  "description": "Rotulos das capturas. Tempos em segundos de BOOT do RX (campo t_ms do log / 1000). Rotulos: EMPTY (sala vazia), STATIC (pessoa parada; inclui atras da parede e 2 pessoas), MOVING (caminhando), ARMS (parado mexendo so os bracos; so nos testes de movimento), UNKNOWN (excluido de treino e metricas). Nomes de fase: E0..En = vazio, P1..Pn = posicoes paradas, P1+P2 = duas pessoas, WALK = caminhada. role=dataset: entra no treino e na validacao cruzada; role=holdout: avaliada so no fim, com o modelo final (nenhuma sessao atual).",
  "label_policy": {
    "guard_start_s": 7.0,
    "guard_end_s": 5.0,
    "note": "Janelas a menos de guard_start_s apos o inicio ou guard_end_s antes do fim de cada fase sao descartadas (5 s de incerteza humana + 2 s de historia da janela CSI no inicio)."
  },
  "calibration": {
    "windows": 20,
    "note": "Emula o firmware: as 20 primeiras assinaturas com t >= calibration_start_s formam a referencia EMPTY. Essas janelas nunca entram em treino nem em metricas."
  },
